CONTROL_PLANE_ENVIRONMENT=production
CONTROL_PLANE_API_INGRESS_MODE=direct_tls
CONTROL_PLANE_PUBLIC_BASE_URL=https://api.aether-3d.com
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aether_control

CONTROL_PLANE_OBJECT_STORAGE_PROVIDER=s3_compatible
CONTROL_PLANE_OBJECT_STORAGE_ENDPOINT_URL=https://<regional-object-storage-endpoint>
CONTROL_PLANE_OBJECT_STORAGE_REGION=auto
CONTROL_PLANE_OBJECT_STORAGE_BUCKET=aether-control
CONTROL_PLANE_OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
CONTROL_PLANE_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
CONTROL_PLANE_OBJECT_STORAGE_SESSION_TOKEN=
CONTROL_PLANE_OBJECT_STORAGE_PUBLIC_BASE_URL=https://<public-bucket-base>/aether-control
CONTROL_PLANE_OBJECT_STORAGE_ADDRESSING_STYLE=auto
CONTROL_PLANE_OBJECT_STORAGE_PRESIGN_EXPIRY_SEC=3600
CONTROL_PLANE_OBJECT_STORAGE_MULTIPART_THRESHOLD_BYTES=5242880
CONTROL_PLANE_OBJECT_STORAGE_MULTIPART_PART_SIZE_BYTES=16777216
CONTROL_PLANE_OBJECT_STORAGE_MULTIPART_MAX_CONCURRENCY=12
CONTROL_PLANE_OBJECT_STORAGE_MULTIPART_COMPLETE_GRACE_SEC=120

WORKER_PROVIDER=vast
WORKER_REGION=eu
WORKER_INSTANCE_LABEL=vast-5090-1
WORKER_HOST_FINGERPRINT=sha256:replace-me
WORKER_GPU_MODEL=RTX 5090
WORKER_GPU_COUNT=1
WORKER_VRAM_MB=32607
WORKER_CPU_CORES=32
WORKER_RAM_MB=131072
WORKER_DISK_FREE_MB=200000
WORKER_SOFTWARE_VERSION=worker-0.2.0

WORKER_CONTROL_PLANE_CANCEL_POLL_EVERY=3
WORKER_RUNTIME_POLL_INTERVAL_SEC=5
WORKER_RUNTIME_STALE_TIMEOUT_SEC=150
WORKER_RETAIN_LOCAL_PRIMARY_ARTIFACT=0
WORKER_UPLOAD_AUXILIARY_ARTIFACTS=0

WORKER_DONOR_ROOT=/root/donor_whitebox
WORKER_DONOR_OUTPUT_DIR=/root/donor_whitebox/outputs
WORKER_DONOR_LOGS_DIR=/root/donor_whitebox/logs
WORKER_DONOR_START_SCRIPT=/root/donor_whitebox/scripts/remote_start_realvideo_autofallback_run.sh
